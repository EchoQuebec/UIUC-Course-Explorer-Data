<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="33547" href="schedule/2020/summer/MUS/545/33547.xml"><parents><calendarYear id="2020" href="schedule/2020.xml">2020</calendarYear><term id="120205" href="schedule/2020/summer.xml">Summer 2020</term><subject id="MUS" href="schedule/2020/summer/MUS.xml">Music</subject><course id="545" href="schedule/2020/summer/MUS/545.xml">Topics in Music Education</course></parents><sectionNumber>LIT</sectionNumber><sectionTitle>Seminar in Wind Band Lit</sectionTitle><sectionDateRange>Meets 15-Jun-20 - 10-Jul-20.</sectionDateRange><creditHours>4 hours</creditHours><statusCode>A</statusCode><sectionText>"Past, Present, and Future - Seminar in Wind Band Literature."  This course will explore the past, present, and future of wind literature. Topics to be discussed include wind literature that has become a part of the canon and possible reasons this music continues to be performed today; current trends in wind music; and the future of this genre with an emphasis on how to identify music of quality and how to support and encourage diversity within your programming through collaboration and commissioning.</sectionText><partOfTerm>S2A</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2020-06-15Z</startDate><endDate>2020-07-10Z</endDate><meetings><meeting id="0"><type code="ONL">Online</type><start>02:30 PM</start><end>04:20 PM</end><daysOfTheWeek>TWRF   </daysOfTheWeek><meetingDateRange>Meets 15-Jun-20 - 10-Jul-20.</meetingDateRange><instructors><instructor lastName="Messina" firstName="A">Messina, A</instructor><instructor lastName="Sweet" firstName="B">Sweet, B</instructor></instructors></meeting></meetings></ns2:section>