<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="69475" href="schedule/2020/spring/ECE/298/69475.xml"><parents><calendarYear id="2020" href="schedule/2020.xml">2020</calendarYear><term id="120201" href="schedule/2020/spring.xml">Spring 2020</term><subject id="ECE" href="schedule/2020/spring/ECE.xml">Electrical and Computer Engineering</subject><course id="298" href="schedule/2020/spring/ECE/298.xml">Special Topics</course></parents><sectionNumber>CLA</sectionNumber><sectionTitle>Engineering Complex Linear Alg</sectionTitle><sectionDateRange>Meets 16-Mar-20 - 06-May-20.</sectionDateRange><creditHours>2 hours</creditHours><statusCode>A</statusCode><sectionText>Engineering Complex Linear Algebra This course can be taken together with ECE 210 to provide a deeper mathematical treatment of complex analysis and linear algebra techniques utilized in ECE 210 and 310. Contour integration methods on the complex plane are introduced and applied in inverse Laplace transform use in circuit and signal analysis and the solution of boundary value problems. The course includes historical context, to increase comprehension. Prerequisites: ECE 210 or 310 (concurrent).</sectionText><partOfTerm>B</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2020-03-16Z</startDate><endDate>2020-05-06Z</endDate><meetings><meeting id="0"><type code="LEC">Lecture</type><start>01:00 PM</start><end>01:50 PM</end><daysOfTheWeek>MWF    </daysOfTheWeek><roomNumber>3081</roomNumber><meetingDateRange>Meets 16-Mar-20 - 06-May-20.</meetingDateRange><buildingName>Electrical &amp; Computer Eng Bldg</buildingName><instructors><instructor lastName="Allen" firstName="J">Allen, J</instructor></instructors></meeting></meetings></ns2:section>