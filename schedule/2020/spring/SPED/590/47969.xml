<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="47969" href="schedule/2020/spring/SPED/590/47969.xml"><parents><calendarYear id="2020" href="schedule/2020.xml">2020</calendarYear><term id="120201" href="schedule/2020/spring.xml">Spring 2020</term><subject id="SPED" href="schedule/2020/spring/SPED.xml">Special Education</subject><course id="590" href="schedule/2020/spring/SPED/590.xml">Seminar for Advanced Students</course></parents><sectionNumber>TI3</sectionNumber><sectionTitle>Trauma Seminar</sectionTitle><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>Participants will explore current issues in the field related to the intersection between young children with disabilities and trauma. Specifically, topics will focus on the provision of trauma-informed care, work with families, self-care, prevention, and building awareness related to the connection between trauma and disability. Additionally, there will be a focus on cross-disciplinary work to enhance services for young children.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2020-01-21Z</startDate><endDate>2020-05-06Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>09:00 AM</start><end>10:50 AM</end><daysOfTheWeek>F      </daysOfTheWeek><roomNumber>210A</roomNumber><buildingName>Education Building</buildingName><instructors><instructor lastName="Miller" firstName="D">Miller, D</instructor></instructors></meeting></meetings></ns2:section>