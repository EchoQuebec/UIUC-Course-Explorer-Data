<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="72061" href="schedule/2019/fall/ANTH/399/72061.xml"><parents><calendarYear id="2019" href="schedule/2019.xml">2019</calendarYear><term id="120198" href="schedule/2019/fall.xml">Fall 2019</term><subject id="ANTH" href="schedule/2019/fall/ANTH.xml">Anthropology</subject><course id="399" href="schedule/2019/fall/ANTH/399.xml">Special Topics</course></parents><sectionNumber>AL1</sectionNumber><sectionTitle>Virtual Archaeology</sectionTitle><statusCode>A</statusCode><sectionText>This course will introduce concepts, techniques and methodologies in archaeological field research through participation in virtual excavation, artifact recovery, analysis and interpretation. Virtual archaeology will include weekly activities in virtual reality where students will use empirical evidence to uncover and reconstruct pieces of the past.  No prerequisite, but students must be willing and able to use the HTC Vive VR system</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2019-08-26Z</startDate><endDate>2019-12-11Z</endDate><meetings><meeting id="0"><type code="LEC">Lecture</type><start>02:00 PM</start><end>02:50 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>304</roomNumber><buildingName>English Building</buildingName><instructors><instructor lastName="Shackelford" firstName="L">Shackelford, L</instructor></instructors></meeting></meetings></ns2:section>