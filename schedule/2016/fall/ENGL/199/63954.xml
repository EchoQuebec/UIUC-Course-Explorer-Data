<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="63954" href="schedule/2016/fall/ENGL/199/63954.xml"><parents><calendarYear id="2016" href="schedule/2016.xml">2016</calendarYear><term id="120168" href="schedule/2016/fall.xml">Fall 2016</term><subject id="ENGL" href="schedule/2016/fall/ENGL.xml">English</subject><course id="199" href="schedule/2016/fall/ENGL/199.xml">Undergraduate Open Seminar</course></parents><sectionNumber>INT</sectionNumber><sectionTitle>Internship Seminar</sectionTitle><sectionDateRange>Meets 17-Oct-16 - 07-Dec-16.</sectionDateRange><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>This course is for English and creative writing majors who have obtained internships and who want or need academic credit for their work. Through regular meetings and short but rigorous weekly writing assignments, students will envision and research individual career trajectories, begin building networks to support those plans, and create meaningful connections between their internships, their classes, and their postgraduation goals. DEPARTMENTAL APPROVAL is needed to enroll.</sectionText><partOfTerm>B</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2016-10-17Z</startDate><endDate>2016-12-07Z</endDate><specialApproval>Departmental Approval Required</specialApproval><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>03:30 PM</start><end>04:20 PM</end><daysOfTheWeek>R      </daysOfTheWeek><roomNumber>131</roomNumber><buildingName>English Building</buildingName><instructors><instructor lastName="Wilcox" firstName="K">Wilcox, K</instructor></instructors></meeting></meetings></ns2:section>