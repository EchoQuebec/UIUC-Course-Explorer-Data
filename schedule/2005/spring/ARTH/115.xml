<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="ARTH 115" href="schedule/2005/spring/ARTH/115.xml"><parents><calendarYear id="2005" href="schedule/2005.xml">2005</calendarYear><term id="120051" href="schedule/2005/spring.xml">Spring 2005</term><subject id="ARTH" href="schedule/2005/spring/ARTH.xml">Art--History</subject></parents><label>Themes of Art History</label><description>Surveys the various ways in which objects and images are appreciated in the discipline of Art History, in a chronological order, objects and artistic developments from the history of art.  Introduces students to a variety of approaches to understanding art, from formal and contextual analysis to interpretations relating art to issues of race and gender.   Course may not be repeated for credit.</description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Literature and the Arts course.</sectionDegreeAttributes><genEdCategories><category id="HUM"><description>Humanities &amp; the Arts</description><ns2:genEdAttributes><genEdAttribute code="1LA">Humanities – Lit &amp; Arts</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="40367" href="schedule/2005/spring/ARTH/115/40367.xml">ADA</section><section id="40369" href="schedule/2005/spring/ARTH/115/40369.xml">ADC</section><section id="40370" href="schedule/2005/spring/ARTH/115/40370.xml">ADD</section><section id="40372" href="schedule/2005/spring/ARTH/115/40372.xml">ADE</section><section id="40373" href="schedule/2005/spring/ARTH/115/40373.xml">ADF</section><section id="40375" href="schedule/2005/spring/ARTH/115/40375.xml">ADG</section><section id="39078" href="schedule/2005/spring/ARTH/115/39078.xml">AL1</section></sections></ns2:course>