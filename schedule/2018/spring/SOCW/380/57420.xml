<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="57420" href="schedule/2018/spring/SOCW/380/57420.xml"><parents><calendarYear id="2018" href="schedule/2018.xml">2018</calendarYear><term id="120181" href="schedule/2018/spring.xml">Spring 2018</term><subject id="SOCW" href="schedule/2018/spring/SOCW.xml">Social Work</subject><course id="380" href="schedule/2018/spring/SOCW/380.xml">Current Topics in Social Work</course></parents><sectionNumber>B  </sectionNumber><sectionTitle>GR&amp;E Inequity in Brazil</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>Gender, Race, and Employment Inequity in Brazil  “The course will investigate scholarship on the intersection of race and gender, with a particular focus on the Brazilian labor market. We assume, as a departure point, that an intersectional approach enriches labor market research and theorizing about economic inequality. Four main discussions will be addressed in the four sections of the program.”</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2018-01-16Z</startDate><endDate>2018-05-02Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>04:00 PM</start><end>06:50 PM</end><daysOfTheWeek>R      </daysOfTheWeek><roomNumber>2018</roomNumber><buildingName>1010 W Nevada</buildingName><instructors><instructor lastName="Araujo Guimaraes" firstName="N">Araujo Guimaraes, N</instructor></instructors></meeting></meetings></ns2:section>