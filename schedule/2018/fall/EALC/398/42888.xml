<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="42888" href="schedule/2018/fall/EALC/398/42888.xml"><parents><calendarYear id="2018" href="schedule/2018.xml">2018</calendarYear><term id="120188" href="schedule/2018/fall.xml">Fall 2018</term><subject id="EALC" href="schedule/2018/fall/EALC.xml">East Asian Language and Culture</subject><course id="398" href="schedule/2018/fall/EALC/398.xml">Colloquium in EALC</course></parents><sectionNumber>GPP</sectionNumber><sectionTitle>JAPN Cult/Hist/Lit</sectionTitle><statusCode>A</statusCode><sectionText>Topic: Recycling the Classics: A Multi-media History of Reception and Adaptation. The course explores the many forms that adaptation has taken through Japanese cultural history. We will explore how cultural material from the Heian and medieval periods has been reused and recycled in literature, the visual arts, film, theater up to the present day. We will also investigate what is at stake in the process of adapting existing cultural material for new audiences, and the diverse roles played by adaptation in society, history, religion, etc.   This course meets with EALC 550 GPP.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2018-08-27Z</startDate><endDate>2018-12-12Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>02:00 PM</start><end>03:50 PM</end><daysOfTheWeek>W      </daysOfTheWeek><roomNumber>1140</roomNumber><buildingName>Foreign Languages Building</buildingName><instructors><instructor lastName="Persiani" firstName="G">Persiani, G</instructor></instructors></meeting><meeting id="1"><type code="LCD">Lecture-Discussion</type><start>02:00 PM</start><end>02:50 PM</end><daysOfTheWeek>M      </daysOfTheWeek><roomNumber>1040</roomNumber><buildingName>Foreign Languages Building</buildingName><instructors><instructor lastName="Persiani" firstName=