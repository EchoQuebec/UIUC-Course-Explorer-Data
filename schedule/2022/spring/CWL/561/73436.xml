<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="73436" href="schedule/2022/spring/CWL/561/73436.xml"><parents><calendarYear id="2022" href="schedule/2022.xml">2022</calendarYear><term id="120221" href="schedule/2022/spring.xml">Spring 2022</term><subject id="CWL" href="schedule/2022/spring/CWL.xml">Comparative and World Literature</subject><course id="561" href="schedule/2022/spring/CWL/561.xml">Seminar Genres - Forms</course></parents><sectionNumber>BAK</sectionNumber><sectionTitle>Reading World Literature</sectionTitle><creditHours>4 hours</creditHours><statusCode>A</statusCode><sectionText>Reading World Literature This course is open to graduate students in all fields who want to expand their close reading practices. We'll read a variety of texts and use diverse critical skills to approach literary analysis. Polyglots can read in the original languages, but all books will be available in English and students will propose some of the readings. Everyone will write short essays throughout the semester that examine the "universe in a grain of sand."</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2022-01-18Z</startDate><endDate>2022-05-04Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>03:30 PM</start><end>05:50 PM</end><daysOfTheWeek>R      </daysOfTheWeek><roomNumber>135</roomNumber><buildingName>English Building</buildingName><instructors><instructor lastName="Kaplan" firstName="B">Kaplan, B</instructor></instructors></meeting></meetings></ns2:section>