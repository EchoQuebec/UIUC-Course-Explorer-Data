<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="50434" href="schedule/2022/fall/SPED/590/50434.xml"><parents><calendarYear id="2022" href="schedule/2022.xml">2022</calendarYear><term id="120228" href="schedule/2022/fall.xml">Fall 2022</term><subject id="SPED" href="schedule/2022/fall/SPED.xml">Special Education</subject><course id="590" href="schedule/2022/fall/SPED/590.xml">Seminar for Advanced Students</course></parents><sectionNumber>TI3</sectionNumber><sectionTitle>Trauma Seminar</sectionTitle><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>Participants will explore current issues in the field related to the intersection between young children with disabilities and trauma.  Specifically, topics will focus on the provision of trauma-informed care, work with families, self-care, prevention, and building awareness related to the connection between trauma and disability. Additionally, there will be a focus on cross-disciplinary work to enhance services for young children.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>CrossListOpen (Restricted)</enrollmentStatus><startDate>2022-08-22Z</startDate><endDate>2022-12-07Z</endDate><meetings><meeting id="0"><type code="ONL">Online</type><start>09:00 AM</start><end>10:50 AM</end><daysOfTheWeek>F      </daysOfTheWeek><instructors><instructor lastName="Miller" firstName="D">Miller, D</instructor></instructors></meeting></meetings></ns2:section>