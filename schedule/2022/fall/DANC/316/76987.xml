<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="76987" href="schedule/2022/fall/DANC/316/76987.xml"><parents><calendarYear id="2022" href="schedule/2022.xml">2022</calendarYear><term id="120228" href="schedule/2022/fall.xml">Fall 2022</term><subject id="DANC" href="schedule/2022/fall/DANC.xml">Dance</subject><course id="316" href="schedule/2022/fall/DANC/316.xml">Dancing Techniques Elective</course></parents><sectionNumber>E  </sectionNumber><sectionTitle>Dancing Techniques: Ballroom</sectionTitle><statusCode>A</statusCode><sectionText>316 Ballroom: This course is an introduction to partnering techniques through the lens of popular ballroom and Latin dances (waltz, tango, rumba, cha cha, etc.). This class will also provide cultural contexts of the dances from their European, Latin American, and Afro-Cuban origins to their current, cosmopolitan forms. May be repeated. This section is primarily for dance majors new to ballroom.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>CrossListOpen</enrollmentStatus><startDate>2022-08-22Z</startDate><endDate>2022-12-07Z</endDate><meetings><meeting id="0"><type code="B2 ">Laboratory</type><start>05:00 PM</start><end>06:20 PM</end><daysOfTheWeek>MW     </daysOfTheWeek><roomNumber>2500</roomNumber><buildingName>Krannert Center for Perf Arts</buildingName><instructors><instructor lastName="Tecza" firstName="A">Tecza, A</instructor></instructors></meeting></meetings></ns2:section>