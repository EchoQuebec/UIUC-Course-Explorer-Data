<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="GEOL 101" href="schedule/2008/spring/GEOL/101.xml"><parents><calendarYear id="2008" href="schedule/2008.xml">2008</calendarYear><term id="120081" href="schedule/2008/spring.xml">Spring 2008</term><subject id="GEOL" href="schedule/2008/spring/GEOL.xml">Geology</subject></parents><label>Introductory Physical Geology</label><description>Focuses on physical features of our planet and their origin. Topics include: plate tectonics, mountain building, glaciers, earthquakes, volcanoes, coastlines, rivers, deserts, geologic structures, weathering, minerals, and rocks. Introduces fundamental methodology for observing and interpreting earth features. Intended for non-physical science majors. Credit is not given for both GEOL 101 and GEOL 100, GEOL 103, GEOL 107, or GEOL 111. </description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Physical Sciences course.</sectionDegreeAttributes><genEdCategories><category id="NAT"><description>Natural Sciences &amp; Technology</description><ns2:genEdAttributes><genEdAttribute code="1PS">Nat Sci &amp; Tech - Phys Sciences</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="33461" href="schedule/2008/spring/GEOL/101/33461.xml">AL1</section><section id="33445" href="schedule/2008/spring/GEOL/101/33445.xml">AY1</section><section id="33447" href="schedule/2008/spring/GEOL/101/33447.xml">AY2</section><section id="44322" href="schedule/2008/spring/GEOL/101/44322.xml">AY3</section><section id="33449" href="schedule/2008/spring/GEOL/101/33449.xml">AY4</section><section id="33451" href="schedule/2008/spring/GEOL/101/33451.xml">AY5</section><section id="33454" href="schedule/2008/spring/GEOL/101/33454.xml">AY6</section><section id="33459" href="schedule/2008/spring/GEOL/101/33459.xml">AY8</section></sections></ns2:course>