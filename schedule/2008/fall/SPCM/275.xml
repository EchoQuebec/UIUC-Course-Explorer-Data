<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="SPCM 275" href="schedule/2008/fall/SPCM/275.xml"><parents><calendarYear id="2008" href="schedule/2008.xml">2008</calendarYear><term id="120088" href="schedule/2008/fall.xml">Fall 2008</term><subject id="SPCM" href="schedule/2008/fall/SPCM.xml">Speech Communication</subject></parents><label>Media, Money and Power</label><description>Describes the political economy of the media in the U.S. Acquaints students with a core understanding of how the media system operates, and with what effects, in a capitalist society. Examines the role of advertising, public relations, corporate concentration, and government regulation upon news reporting, entertainment, culture, and participatory democracy. Also examines issues such as the Internet, globalization, and public broadcasting.</description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Hist&amp;Philosoph Perspect, and Western Compartv Cult course.</sectionDegreeAttributes><genEdCategories><category id="HUM"><description>Humanities &amp; the Arts</description><ns2:genEdAttributes><genEdAttribute code="1HP">Humanities – Hist &amp; Phil</genEdAttribute></ns2:genEdAttributes></category><category id="CS"><description>Cultural Studies</description><ns2:genEdAttributes><genEdAttribute code="1WCC">Cultural Studies - Western</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="51514" href="schedule/2008/fall/SPCM/275/51514.xml">ADA</section><section id="51515" href="schedule/2008/fall/SPCM/275/51515.xml">ADB</section><section id="51516" href="schedule/2008/fall/SPCM/275/51516.xml">ADC</section><section id="51517" href="schedule/2008/fall/SPCM/275/51517.xml">ADD</section><section id="51518" href="schedule/2008/fall/SPCM/275/51518.xml">ADE</section><section id="51519" href="schedule/2008/fall/SPCM/275/51519.xml">ADF</section><section id="51520" href="schedule/2008/fall/SPCM/275