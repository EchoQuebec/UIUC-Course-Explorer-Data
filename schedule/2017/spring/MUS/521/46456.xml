<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="46456" href="schedule/2017/spring/MUS/521/46456.xml"><parents><calendarYear id="2017" href="schedule/2017.xml">2017</calendarYear><term id="120171" href="schedule/2017/spring.xml">Spring 2017</term><subject id="MUS" href="schedule/2017/spring/MUS.xml">Music</subject><course id="521" href="schedule/2017/spring/MUS/521.xml">Hist Studies in 20thC Music</course></parents><sectionNumber>A  </sectionNumber><sectionTitle>Contemporary Film Music</sectionTitle><creditHours>4 hours</creditHours><statusCode>A</statusCode><sectionText>“Contemporary Film Music.” This seminar will offer in-depth study of the use of music and sound within contemporary art films, specifically the use of pre-existing and originally composed music by filmmakers since the Second World War. Directors studied will include Akira Kurosawa, Jean-Luc Godard, Ingmar Bergman, Robert Altman, Stanley Kubrick, Jane Campion, Derek Jarman, Quentin Tarantino, Pedro Almodovar, Paul Thomas Anderson, and Tran Anh Hung.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2017-01-17Z</startDate><endDate>2017-05-03Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>10:30 AM</start><end>12:50 PM</end><daysOfTheWeek>M      </daysOfTheWeek><roomNumber>0356</roomNumber><buildingName>Music Building</buildingName><instructors><instructor lastName="Magee" firstName="G">Magee, G</instructor></instructors></meeting></meetings></ns2:section>