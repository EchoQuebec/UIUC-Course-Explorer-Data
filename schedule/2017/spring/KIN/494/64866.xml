<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="64866" href="schedule/2017/spring/KIN/494/64866.xml"><parents><calendarYear id="2017" href="schedule/2017.xml">2017</calendarYear><term id="120171" href="schedule/2017/spring.xml">Spring 2017</term><subject id="KIN" href="schedule/2017/spring/KIN.xml">Kinesiology</subject><course id="494" href="schedule/2017/spring/KIN/494.xml">Special Topics</course></parents><sectionNumber>KWG</sectionNumber><sectionTitle>Special Topics: Nutrition &amp; Ex</sectionTitle><creditHours>4 hours</creditHours><statusCode>A</statusCode><sectionText>Nutrition &amp; Exercise in Chronic Kidney Disease:  In this course, we will review the scientific literature pertaining to physical activity and nutritional recommendations for individuals with chronic kidney disease.  The rationale for these guidelines will be discussed, and the literature supporting these recommendations will be critically reviewed.  Alternative recommendations will also be developed and discussed.</sectionText><sectionNotes>Restricted to Graduate - Urbana-Champaign.</sectionNotes><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2017-01-17Z</startDate><endDate>2017-05-03Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>09:30 AM</start><end>10:50 AM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>393</roomNumber><buildingName>Bevier Hall</buildingName><instructors><instructor lastName="Wilund" firstName="K">Wilund, K</instructor></instructors></meeting></meetings></ns2:section>