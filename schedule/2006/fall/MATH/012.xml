<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="MATH 012" href="schedule/2006/fall/MATH/012.xml"><parents><calendarYear id="2006" href="schedule/2006.xml">2006</calendarYear><term id="120068" href="schedule/2006/fall.xml">Fall 2006</term><subject id="MATH" href="schedule/2006/fall/MATH.xml">Mathematics</subject></parents><label>Algebra</label><description>Rapid review of basic techniques of factoring, rational expressions, equations and inequalities; functions and graphs; exponential and logarithm functions; systems of equations; matrices and determinants; polynomials; and the binomial theorem. Students who need both algebra and trigonometry should enroll in MATH 016.  Credit is not given for both MATH 012 and MATH 016. Credit not applicable toward graduation in certain curricula.  Prerequisite: 1.5 units of high school algebra, and 1 unit of high school geometry.  </description><creditHours>3 hours.</creditHours><sections><section id="40212" href="schedule/2006/fall/MATH/012/40212.xml">AD1</section><section id="40213" href="schedule/2006/fall/MATH/012/40213.xml">AD2</section><section id="40214" href="schedule/2006/fall/MATH/012/40214.xml">AD3</section><section id="40215" href="schedule/2006/fall/MATH/012/40215.xml">AD4</section><section id="32266" href="schedule/2006/fall/MATH/012/32266.xml">AL1</section><section id="40216" href="schedule/2006/fall/MATH/012/40216.xml">BD1</section><section id="40217" href="schedule/2006/fall/MATH/012/40217.xml">BD2</section><section id="40218" href="schedule/2006/fall/MATH/012/40218.xml">BD3</section><section id="40219" href="schedule/2006/fall/MATH/012/40219.xml">BD4</section><section id="32270" href="schedule/2006/fall/MATH/012/32270.xml">BL1</section><section id="32267" href="schedule/2006/fall/MATH/012/32267.xml">D2 </section><section id="32271" href="schedule/2006/fall/MATH/012/32271.xml">X2 </section></sections></ns2:course>