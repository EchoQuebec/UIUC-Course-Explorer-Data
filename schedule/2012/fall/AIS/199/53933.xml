<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="53933" href="schedule/2012/fall/AIS/199/53933.xml"><parents><calendarYear id="2012" href="schedule/2012.xml">2012</calendarYear><term id="120128" href="schedule/2012/fall.xml">Fall 2012</term><subject id="AIS" href="schedule/2012/fall/AIS.xml">American Indian Studies</subject><course id="199" href="schedule/2012/fall/AIS/199.xml">Undergraduate Open Seminar</course></parents><sectionNumber>A1 </sectionNumber><sectionTitle>Amer Indian Expressive Culture</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>Topic:  Intro to American Indian Studies:  American Indian Expressive Culture.  This course focuses on various forms of cultural expression among American Indians and other ndigenous peoples, including film, dance, theatre, visual art, and writing. Issues of performance and artistic practice will be of special concern, and the relationship between new and older forms of Indigenous expression will be highlighted.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2012-08-27Z</startDate><endDate>2012-12-12Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>12:30 PM</start><end>01:45 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>1048</roomNumber><buildingName>Foreign Languages Building</buildingName><instructors><instructor lastName="Wilson" firstName="L">Wilson, L</instructor></instructors></meeting></meetings></ns2:section>