<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="ANTH 101" href="schedule/2023/spring/ANTH/101.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="ANTH" href="schedule/2023/spring/ANTH.xml">Anthropology</subject></parents><label>Introduction to Anthropology</label><description>Anthropology was first envisioned as a holistic discipline, combining insights from the study of human anatomy and evolution, research on material remains of human settlements, and the analysis of social interaction in language and other cultural practices. Following this tradition, this course explores the questions about where humans came from, how societies live and communicate, and why human cultural groups vary.</description><creditHours>3 hours.</creditHours><sectionDegreeAttributes>Social &amp; Beh Sci - Soc Sci, and Cultural Studies - Western course.</sectionDegreeAttributes><genEdCategories><category id="SBS"><description>Social &amp; Behavioral Sciences</description><ns2:genEdAttributes><genEdAttribute code="1SS">Social &amp; Beh Sci - Soc Sci</genEdAttribute></ns2:genEdAttributes></category><category id="CS"><description>Cultural Studies</description><ns2:genEdAttributes><genEdAttribute code="1WCC">Cultural Studies - Western</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="74459" href="schedule/2023/spring/ANTH/101/74459.xml">AD1</section><section id="74460" href="schedule/2023/spring/ANTH/101/74460.xml">AD2</section><section id="74461" href="schedule/2023/spring/ANTH/101/74461.xml">AD3</section><section id="74462" href="schedule/2023/spring/ANTH/101/74462.xml">AD4</section><section id="74464" href="schedule/2023/spring/ANTH/101/74464.xml">AD5</section><section id="74465" href="schedule/2023/spring/ANTH/101/74465.xml">AD6</section><section id="74466" href="schedule/2023/s