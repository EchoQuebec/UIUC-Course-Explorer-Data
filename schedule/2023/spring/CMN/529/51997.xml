<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="51997" href="schedule/2023/spring/CMN/529/51997.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="CMN" href="schedule/2023/spring/CMN.xml">Communication</subject><course id="529" href="schedule/2023/spring/CMN/529.xml">Seminar Communication Theory</course></parents><sectionNumber>WB </sectionNumber><sectionTitle>Collaboration &amp; Teams</sectionTitle><statusCode>A</statusCode><sectionText>This course explores how communication and management scholars have examined the concept of “collaboration” within and around organizations. Our discussion will focus on how differing operationalizations of this concept guide scholarly inquiry, and toward identifying opportunities for productive scholarly attention at the interfaces between dominant approaches in collaboration research.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open (Restricted)</enrollmentStatus><startDate>2023-01-17Z</startDate><endDate>2023-05-03Z</endDate><meetings><meeting id="0"><type code="S6 ">Lecture-Discussion</type><start>02:00 PM</start><end>04:50 PM</end><daysOfTheWeek>R      </daysOfTheWeek><roomNumber>4007</roomNumber><buildingName>Lincoln Hall</buildingName><instructors><instructor lastName="Barley" firstName="W">Barley, W</instructor></instructors></meeting></meetings></ns2:section>