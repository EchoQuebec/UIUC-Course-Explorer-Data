<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="73117" href="schedule/2023/spring/ENG/598/73117.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="ENG" href="schedule/2023/spring/ENG.xml">Engineering</subject><course id="598" href="schedule/2023/spring/ENG/598.xml">Special Topics</course></parents><sectionNumber>WTG</sectionNumber><sectionTitle>STEM Writing:Practice/Pedagogy</sectionTitle><creditHours>2 hours</creditHours><statusCode>A</statusCode><sectionText>This course is designed for STEM graduate students to learn how to write for their professional lives as well as a teaching assistant. Using concepts from the field of writing studies, we will discuss writing as a process, genres of STEM writing, and how to give/receive writing feedback. Each class is broken into two parts: (1) writing for professional contexts such as publication and (2) how to teach writing at the undergraduate level.</sectionText><sectionNotes>Restricted to Graduate - Urbana-Champaign.</sectionNotes><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open (Restricted)</enrollmentStatus><startDate>2023-01-17Z</startDate><endDate>2023-05-03Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>01:00 PM</start><end>02:50 PM</end><daysOfTheWeek>F      </daysOfTheWeek><roomNumber>0036</roomNumber><buildingName>Campus Instructional Facility</buildingName><instructors><instructor lastName="Geiger" firstName="A">Geiger, A</instructor></instructors></meeting></meetings></ns2:section>