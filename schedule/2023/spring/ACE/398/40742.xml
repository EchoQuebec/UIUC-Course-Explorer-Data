<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="40742" href="schedule/2023/spring/ACE/398/40742.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="ACE" href="schedule/2023/spring/ACE.xml">Agricultural and Consumer Economics</subject><course id="398" href="schedule/2023/spring/ACE/398.xml">Seminar</course></parents><sectionNumber>XL </sectionNumber><sectionTitle>Adv Spreadsheet Models&amp;Applic</sectionTitle><sectionDateRange>Meets 13-Mar-23 - 03-May-23.</sectionDateRange><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>This course introduces students to advanced spreadsheet models and applications using Microsoft Excel data tools and VBA.  It explores connections to external databases, PivotTables, and Custom Functions, and using VBA to extract data from webpages.  Examples in this course will center on trends in interest rates and employment.  The Final Project is a student-created Monte-Carlo simulation.  Prerequisite: ACE 360 or comparable  Intermediate Excel course or permission of the instructor.</sectionText><partOfTerm>B</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2023-03-13Z</startDate><endDate>2023-05-03Z</endDate><meetings><meeting id="0"><type code="E3 ">Online</type><start>09:00 AM</start><end>10:20 AM</end><daysOfTheWeek>TR     </daysOfTheWeek><meetingDateRange>Meets 13-Mar-23 - 03-May-23.</meetingDateRange><instructors><instructor lastName="Campbell" firstName="W">Campbell, W</instructor></instructors></meeting></meetings></ns2:section>