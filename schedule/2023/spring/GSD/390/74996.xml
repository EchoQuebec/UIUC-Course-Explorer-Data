<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="74996" href="schedule/2023/spring/GSD/390/74996.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="GSD" href="schedule/2023/spring/GSD.xml">Game Studies and Design</subject><course id="390" href="schedule/2023/spring/GSD/390.xml">Special Topics in Game Studies &amp; Design</course></parents><sectionNumber>WGA</sectionNumber><sectionTitle>Literary Hypertext 1: History</sectionTitle><sectionDateRange>Meets 17-Jan-23 - 10-Mar-23.</sectionDateRange><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>Students in this class will learn an overview of electronic literature, primarily works in the fiction tradition. The emphasis will be on the genre once known as Hypertext—branching, multi-sequential narratives for the screen. Students will read, attend discussions, and report on a single hypertext novel or author of their choice.</sectionText><partOfTerm>A</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2023-01-17Z</startDate><endDate>2023-03-10Z</endDate><meetings><meeting id="0"><type code="LBD">Laboratory-Discussion</type><start>05:00 PM</start><end>06:40 PM</end><daysOfTheWeek>M      </daysOfTheWeek><meetingDateRange>Meets 17-Jan-23 - 10-Mar-23.</meetingDateRange><instructors><instructor lastName="Gillespie" firstName="W">Gillespie, W</instructor></instructors></meeting></meetings></ns2:section>