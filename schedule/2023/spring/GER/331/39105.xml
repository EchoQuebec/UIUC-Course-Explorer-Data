<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="39105" href="schedule/2023/spring/GER/331/39105.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="GER" href="schedule/2023/spring/GER.xml">German</subject><course id="331" href="schedule/2023/spring/GER/331.xml">Intro to German Literature</course></parents><sectionNumber>B  </sectionNumber><sectionTitle>Intro to German Culture</sectionTitle><statusCode>A</statusCode><sectionText>We explore German-language culture, literature, and history from the Enlightenment to the present. Our texts engage with reason and madness, love and sexuality, technology and modernization, justice and guilt, community and identity. To better understand the historical and cultural contexts in which these texts were produced, we will examine paintings photography, philosophy, social and political history, and film.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>Open</enrollmentStatus><startDate>2023-01-17Z</startDate><endDate>2023-05-03Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>02:00 PM</start><end>03:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>G24</roomNumber><buildingName>Foreign Languages Building</buildingName><instructors/></meeting></meetings></ns2:section>