<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="ECE 110" href="schedule/2023/spring/ECE/110.xml"><parents><calendarYear id="2023" href="schedule/2023.xml">2023</calendarYear><term id="120231" href="schedule/2023/spring.xml">Spring 2023</term><subject id="ECE" href="schedule/2023/spring/ECE.xml">Electrical and Computer Engineering</subject></parents><label>Introduction to Electronics</label><description>Introduction to selected fundamental concepts and principles in electrical engineering. Emphasis on measurement, modeling, and analysis of circuits and electronics while introducing numerous applications. Includes sub-discipline topics of electrical and computer engineering, for example, electromagnetics, control, signal processing, microelectronics, communications, and scientific computing basics. Lab work incorporates sensors and motors into an autonomous moving vehicle, designed and constructed to perform tasks jointly determined by the instructors and students.</description><creditHours>1 to 3 hours.</creditHours><sectionRegistrationNotes>Not intended for Graduate - Urbana-Champaign.</sectionRegistrationNotes><classScheduleInformation>Students must register for one lab and one lecture section.</classScheduleInformation><sections><section id="32463" href="schedule/2023/spring/ECE/110/32463.xml">AB0</section><section id="32460" href="schedule/2023/spring/ECE/110/32460.xml">AB2</section><section id="52912" href="schedule/2023/spring/ECE/110/52912.xml">AB3</section><section id="32470" href="schedule/2023/spring/ECE/110/32470.xml">AB4</section><section id="52914" href="schedule/2023/spring/ECE/110/52914.xml">AB5</section><section id="52910" href="schedule/2023/spring/ECE/110/52910.xml">AB6</section><section id="32466" href="schedule/2023/spring/ECE/110/32466.xml">AB7</section><section id="32461" href="schedule/2023/spring/ECE/110/32461.xml">AB8</section><section id="52913" href="schedule/2023/spring/ECE/11