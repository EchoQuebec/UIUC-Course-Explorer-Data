<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="46209" href="schedule/2007/spring/EPSY/590/46209.xml"><parents><calendarYear id="2007" href="schedule/2007.xml">2007</calendarYear><term id="120071" href="schedule/2007/spring.xml">Spring 2007</term><subject id="EPSY" href="schedule/2007/spring/EPSY.xml">Educational Psychology</subject><course id="590" href="schedule/2007/spring/EPSY/590.xml">Advanced Seminar in Educ Psyc</course></parents><sectionNumber>AL </sectionNumber><sectionTitle>Advance Seminar in Educ Psyc</sectionTitle><statusCode>A</statusCode><sectionText>Anthropological Approaches to multilingualism  In this seminar, we will read both classic and recent linguistic anthropological studies of multilingual societies. Topics include the dynamics of language shift; language ideologies; theoretical models of codeswitching, diglossia, and the speech community; and the applicability of models used to study multidialectalism (e.g. linguistic style) to multilingual situations.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2007-01-16Z</startDate><endDate>2007-05-02Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>03:00 PM</start><end>05:50 PM</end><daysOfTheWeek>W      </daysOfTheWeek><roomNumber>160</roomNumber><buildingName>Education Building</buildingName><instructors><instructor lastName="Lo" firstName="A">Lo, A</instructor></instructors></meeting></meetings></ns2:section>