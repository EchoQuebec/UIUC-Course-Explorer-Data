<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="AVI 380" href="schedule/2007/fall/AVI/380.xml"><parents><calendarYear id="2007" href="schedule/2007.xml">2007</calendarYear><term id="120078" href="schedule/2007/fall.xml">Fall 2007</term><subject id="AVI" href="schedule/2007/fall/AVI.xml">Aviation</subject></parents><label>Multiengine Land</label><description>Prepares the commercial pilot for an FAA multiengine land airplane rating; 18 hours of discussion and 15 hours of flight in a multiengine airplane (13 hours dual instruction, one-half hour solo, plus 1.5 hours check ride for qualified individuals). Students enrolling in this course will also participate in up to 5 hours of research flight experiments conducted by Institute of Aviation staff.   Prerequisite: Commercial Pilot certificate and consent of director. </description><creditHours>1 hours.</creditHours><sections><section id="37381" href="schedule/2007/fall/AVI/380/37381.xml">FA </section><section id="37382" href="schedule/2007/fall/AVI/380/37382.xml">FB </section><section id="37384" href="schedule/2007/fall/AVI/380/37384.xml">FC </section><section id="37385" href="schedule/2007/fall/AVI/380/37385.xml">FD </section><section id="37387" href="schedule/2007/fall/AVI/380/37387.xml">FE </section><section id="37388" href="schedule/2007/fall/AVI/380/37388.xml">FF </section><section id="41248" href="schedule/2007/fall/AVI/380/41248.xml">FG </section><section id="37392" href="schedule/2007/fall/AVI/380/37392.xml">FH </section><section id="37395" href="schedule/2007/fall/AVI/380/37395.xml">FI </section><section id="37396" href="schedule/2007/fall/AVI/380/37396.xml">FJ </section><section id="37397" href="schedule/2007/fall/AVI/380/37397.xml">FK </section><section id="37400" href="schedule/2007/fall/AVI/380/37400.xml">FL </section></sections></ns2:course>