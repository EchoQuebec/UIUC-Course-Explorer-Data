<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="CPSC 112" href="schedule/2015/spring/CPSC/112.xml"><parents><calendarYear id="2015" href="schedule/2015.xml">2015</calendarYear><term id="120151" href="schedule/2015/spring.xml">Spring 2015</term><subject id="CPSC" href="schedule/2015/spring/CPSC.xml">Crop Sciences</subject></parents><label>Introduction to Crop Sciences</label><description>Introductory course covering principles of growth, production, protection, and improvement of crop plants. Topics covered include form, function, and uses of crops; mechanisms and factors responsible for plant growth and development; crop pests and pest protection; specific crops; and advances in crop production. Concepts are discussed in lecture and reinforced in corresponding hands-on laboratory sections.</description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Life Sciences course.</sectionDegreeAttributes><genEdCategories><category id="NAT"><description>Natural Sciences &amp; Technology</description><ns2:genEdAttributes><genEdAttribute code="1LS">Nat Sci &amp; Tech - Life Sciences</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="31481" href="schedule/2015/spring/CPSC/112/31481.xml">AB1</section><section id="31483" href="schedule/2015/spring/CPSC/112/31483.xml">AB2</section><section id="56572" href="schedule/2015/spring/CPSC/112/56572.xml">AB3</section><section id="62326" href="schedule/2015/spring/CPSC/112/62326.xml">AB4</section><section id="62327" href="schedule/2015/spring/CPSC/112/62327.xml">AB5</section><section id="31487" href="schedule/2015/spring/CPSC/112/31487.xml">AL1</section></sections></ns2:course>