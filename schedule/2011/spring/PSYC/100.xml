<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="PSYC 100" href="schedule/2011/spring/PSYC/100.xml"><parents><calendarYear id="2011" href="schedule/2011.xml">2011</calendarYear><term id="120111" href="schedule/2011/spring.xml">Spring 2011</term><subject id="PSYC" href="schedule/2011/spring/PSYC.xml">Psychology</subject></parents><label>Intro Psych</label><description>Study of human behavior with special reference to perception, learning, memory, thinking, emotional life, and individual differences in intelligence, aptitude, and personality; emphasis on the scientific nature of psychological investigations; and discussion of research methods and the relation of their results to daily life and everyday problems. Lectures, discussions, and six hours of participation as a subject in psychological experiments. Credit is not given for both PSYC 100 and either PSYC 103 or PSYC 105.</description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Behavioral Sciences course.</sectionDegreeAttributes><genEdCategories><category id="SBS"><description>Social &amp; Behavioral Sciences</description><ns2:genEdAttributes><genEdAttribute code="1BSC">Social &amp; Beh Sci - Beh Sci</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="37005" href="schedule/2011/spring/PSYC/100/37005.xml">A1 </section><section id="37007" href="schedule/2011/spring/PSYC/100/37007.xml">B1 </section><section id="37008" href="schedule/2011/spring/PSYC/100/37008.xml">B2 </section><section id="51285" href="schedule/2011/spring/PSYC/100/51285.xml">B3 </section><section id="37009" href="schedule/2011/spring/PSYC/100/37009.xml">C1 </section><section id="40736" href="schedule/2011/spring/PSYC/100/40736.xml">C3 </section><section id="37010" href="schedule/2011/spring/PSYC/100/37010.xml">D1 </section><section id="48856" href="schedule/2011/spring/PSYC/100/48856.xml">D3 </section><section id="40738" href="sched