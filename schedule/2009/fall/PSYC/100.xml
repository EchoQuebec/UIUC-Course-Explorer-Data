<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="PSYC 100" href="schedule/2009/fall/PSYC/100.xml"><parents><calendarYear id="2009" href="schedule/2009.xml">2009</calendarYear><term id="120098" href="schedule/2009/fall.xml">Fall 2009</term><subject id="PSYC" href="schedule/2009/fall/PSYC.xml">Psychology</subject></parents><label>Intro Psych</label><description>Study of human behavior with special reference to perception, learning, memory, thinking, emotional life, and individual differences in intelligence, aptitude, and personality; emphasis on the scientific nature of psychological investigations; and discussion of research methods and the relation of their results to daily life and everyday problems. Lectures, discussions, and six hours of participation as a subject in psychological experiments. Credit is not given for both PSYC 100 and either PSYC 103 or PSYC 105.</description><creditHours>4 hours.</creditHours><sectionDegreeAttributes>Behavioral Sciences course.</sectionDegreeAttributes><genEdCategories><category id="SBS"><description>Social &amp; Behavioral Sciences</description><ns2:genEdAttributes><genEdAttribute code="1BSC">Social &amp; Beh Sci - Beh Sci</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="35690" href="schedule/2009/fall/PSYC/100/35690.xml">A1 </section><section id="35695" href="schedule/2009/fall/PSYC/100/35695.xml">A2 </section><section id="35699" href="schedule/2009/fall/PSYC/100/35699.xml">B1 </section><section id="35704" href="schedule/2009/fall/PSYC/100/35704.xml">B2 </section><section id="50609" href="schedule/2009/fall/PSYC/100/50609.xml">B5 </section><section id="35716" href="schedule/2009/fall/PSYC/100/35716.xml">C1 </section><section id="35719" href="schedule/2009/fall/PSYC/100/35719.xml">C2 </section><section id="43472" href="schedule/2009/fall/PSYC/100/43472.xml">C5 </section><section id="35723" href="schedule/2009/fall/PSYC/100/3