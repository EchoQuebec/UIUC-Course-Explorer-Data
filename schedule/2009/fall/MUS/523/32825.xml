<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="32825" href="schedule/2009/fall/MUS/523/32825.xml"><parents><calendarYear id="2009" href="schedule/2009.xml">2009</calendarYear><term id="120098" href="schedule/2009/fall.xml">Fall 2009</term><subject id="MUS" href="schedule/2009/fall/MUS.xml">Music</subject><course id="523" href="schedule/2009/fall/MUS/523.xml">Seminar in Musicology</course></parents><sectionNumber>C  </sectionNumber><statusCode>A</statusCode><sectionText>MUSIC AND RELIGION  The seminar will investigate the impact of religious practices in the broadest sense on the composition, transmission and performance of music. Readings will be drawn from texts on liturgy, theology, social history and folklore in addition to musicological studies. Students may choose specific topics for discussion within the parameters of the course.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2009-08-24Z</startDate><endDate>2009-12-09Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>01:00 PM</start><end>03:50 PM</end><daysOfTheWeek>F      </daysOfTheWeek><roomNumber>3142</roomNumber><buildingName>Music Building</buildingName><instructors><instructor lastName="Ward" firstName="T">Ward, T</instructor></instructors></meeting></meetings></ns2:section>