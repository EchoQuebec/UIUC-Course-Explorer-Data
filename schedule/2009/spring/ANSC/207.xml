<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="ANSC 207" href="schedule/2009/spring/ANSC/207.xml"><parents><calendarYear id="2009" href="schedule/2009.xml">2009</calendarYear><term id="120091" href="schedule/2009/spring.xml">Spring 2009</term><subject id="ANSC" href="schedule/2009/spring/ANSC.xml">Animal Sciences</subject></parents><label>Companion Animal Biology &amp;Care</label><description>An introduction to companion animal biology through consideration of the physical structure, nutrition, behavior, and reproduction of mammals, birds, reptiles, amphibians and fish. Basic biological concepts contribute to discussion of best husbandry practices and preventive health care. Legal and economics issues, ethical considerations, and other topics associated with companion animals are also discussed.</description><creditHours>3 hours.</creditHours><sectionDegreeAttributes>Life Sciences course.</sectionDegreeAttributes><genEdCategories><category id="NAT"><description>Natural Sciences &amp; Technology</description><ns2:genEdAttributes><genEdAttribute code="1LS">Nat Sci &amp; Tech - Life Sciences</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="50316" href="schedule/2009/spring/ANSC/207/50316.xml">AD1</section><section id="50321" href="schedule/2009/spring/ANSC/207/50321.xml">AD2</section><section id="50323" href="schedule/2009/spring/ANSC/207/50323.xml">AD3</section><section id="50324" href="schedule/2009/spring/ANSC/207/50324.xml">AD4</section><section id="50325" href="schedule/2009/spring/ANSC/207/50325.xml">AD5</section><section id="50313" href="schedule/2009/spring/ANSC/207/50313.xml">AL1</section></sections></ns2:course>