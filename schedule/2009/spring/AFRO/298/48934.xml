<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="48934" href="schedule/2009/spring/AFRO/298/48934.xml"><parents><calendarYear id="2009" href="schedule/2009.xml">2009</calendarYear><term id="120091" href="schedule/2009/spring.xml">Spring 2009</term><subject id="AFRO" href="schedule/2009/spring/AFRO.xml">African American Studies</subject><course id="298" href="schedule/2009/spring/AFRO/298.xml">Spec Topics African-Am Studies</course></parents><sectionNumber>JW </sectionNumber><sectionTitle>Black Panther Party &amp; Beyond</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>This course is an examination of African American social and political life in American urban centers from the 1960s to the present.  A particular emphasis will investigate the Black Panther Party and the aftermath of its destruction.  Discussions will highlight the Panther's impact on recent social and political movements and entities.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2009-01-20Z</startDate><endDate>2009-05-06Z</endDate><meetings><meeting id="0"><type code="LCD">Lecture-Discussion</type><start>12:00 PM</start><end>01:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>137</roomNumber><buildingName>Armory</buildingName><instructors><instructor lastName="Williams" firstName="J">Williams, J</instructor></instructors></meeting></meetings></ns2:section>