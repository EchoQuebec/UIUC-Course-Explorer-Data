<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="58698" href="schedule/2013/spring/ARTH/310/58698.xml"><parents><calendarYear id="2013" href="schedule/2013.xml">2013</calendarYear><term id="120131" href="schedule/2013/spring.xml">Spring 2013</term><subject id="ARTH" href="schedule/2013/spring/ARTH.xml">Art--History</subject><course id="310" href="schedule/2013/spring/ARTH/310.xml">African Art and Society I</course></parents><sectionNumber>PM </sectionNumber><statusCode>A</statusCode><sectionText>Topic: Islamic Arts of Africa: Muslim Identities at the Crossroads.This class explores how artists negotiate the relationship between culture, faith, and politics.  Focuses on histories of cultural exchange between Muslim and non-Muslim societies within Africa and beyond.  Subjects will range from mosque architecture and calligraphic abstraction to the contemporary art scene in such global "Islamic" cities as Cairo.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2013-01-14Z</startDate><endDate>2013-05-01Z</endDate><meetings><meeting id="0"><type code="LEC">Lecture</type><start>11:00 AM</start><end>12:20 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>302</roomNumber><buildingName>Architecture Building</buildingName><instructors><instructor lastName="Meier" firstName="S">Meier, S</instructor></instructors></meeting></meetings></ns2:section>