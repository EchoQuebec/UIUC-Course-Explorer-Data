<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="IB 202" href="schedule/2013/spring/IB/202.xml"><parents><calendarYear id="2013" href="schedule/2013.xml">2013</calendarYear><term id="120131" href="schedule/2013/spring.xml">Spring 2013</term><subject id="IB" href="schedule/2013/spring/IB.xml">Integrative Biology</subject></parents><label>Anatomy and Physiology</label><description>How animals function in acquiring, processing, and allocating resources in the face of environmental constraints. The inquiry-based laboratory emphasizes testing of hypotheses related to functioning of anatomical and physiological components of the basic systems of animals. Lecture only, 3 hours; with laboratory, 4 hours. Students must complete the laboratory portion of the course to receive 4 hours of credit. The laboratory includes vertebrate dissection. Prerequisite: IB 150 and MCB 150.</description><creditHours>0 TO 4 hours.</creditHours><sections><section id="34642" href="schedule/2013/spring/IB/202/34642.xml">AB1</section><section id="34644" href="schedule/2013/spring/IB/202/34644.xml">AB3</section><section id="34645" href="schedule/2013/spring/IB/202/34645.xml">AB4</section><section id="34646" href="schedule/2013/spring/IB/202/34646.xml">AB5</section><section id="34647" href="schedule/2013/spring/IB/202/34647.xml">AB6</section><section id="39250" href="schedule/2013/spring/IB/202/39250.xml">AB7</section><section id="39251" href="schedule/2013/spring/IB/202/39251.xml">AB8</section><section id="49356" href="schedule/2013/spring/IB/202/49356.xml">ABA</section><section id="55944" href="schedule/2013/spring/IB/202/55944.xml">ABB</section><section id="56959" href="schedule/2013/spring/IB/202/56959.xml">ABC</section><section id="34641" href="schedule/2013/spring/IB/202/34641.xml">AL1</section><section id="59272" href="schedule/2013/spring/IB/202/59272.xml">AL2</section></sections></ns2:course>