<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="61263" href="schedule/2013/fall/ESE/497/61263.xml"><parents><calendarYear id="2013" href="schedule/2013.xml">2013</calendarYear><term id="120138" href="schedule/2013/fall.xml">Fall 2013</term><subject id="ESE" href="schedule/2013/fall/ESE.xml">Earth, Society, and Environment</subject><course id="497" href="schedule/2013/fall/ESE/497.xml">Special Topics in ESE</course></parents><sectionNumber>SL </sectionNumber><sectionTitle>Dixon Springs Field Trip</sectionTitle><sectionDateRange>Meets 26-Aug-13 - 18-Oct-13.</sectionDateRange><creditHours>1 hours</creditHours><statusCode>A</statusCode><sectionText>A weekend field trip to Dixon Springs in southern Illinois for Sustainablility LLC residents that investigates the environment of Southern Illinois, examining the ecology, geology and sustainability of the region.  Activities will include a writing workshop, a tour of Midwestern forests and wetlands, nature photography, and geological hike.  The trip begins on the evening of Friday the 20th of September and returns on Sunday the 22nd of September.  Grading will be S/U.  The SLLC is subsidizing the transportation costs.  There is a field trip fee of $85.00.</sectionText><sectionCappArea>Restricted to Sustainability LLC students.</sectionCappArea><sectionFeeAmount>LAS Field Trip $85.00 Flat Fee.</sectionFeeAmount><partOfTerm>A</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2013-08-26Z</startDate><endDate>2013-10-18Z</endDate><meetings><meeting id="0"><type code="CNF">Conference</type><start>05:00 PM</start><end>06:20 PM</end><daysOfTheWeek>R      </daysOfTheWeek><roomNumber>165</roomNumber><buildingName>Noyes Laboratory</buildingName><instructors><instructor lastName="Nesbitt" firstName="A">Nesbitt, A</instructor></instructors></meeting></meetings></ns2:section>