<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="55965" href="schedule/2013/fall/CS/498/55965.xml"><parents><calendarYear id="2013" href="schedule/2013.xml">2013</calendarYear><term id="120138" href="schedule/2013/fall.xml">Fall 2013</term><subject id="CS" href="schedule/2013/fall/CS.xml">Computer Science</subject><course id="498" href="schedule/2013/fall/CS/498.xml">Special Topics</course></parents><sectionNumber>DH4</sectionNumber><sectionTitle>Computational Photography</sectionTitle><creditHours>4 hours</creditHours><statusCode>A</statusCode><sectionText>Topic:  Computational Photography. This course explores how to use computer vision techniques to enhance, manipulate, and create media from photo collections.  Topics will include photo stitching, face morphing, texture synthesis, recoloring, and 3D reconstruction.   This projects-based course is intended for advanced undergraduates; some programming ability and knowledge of linear algebra will be assumed.   This section is for graduate students only.</sectionText><sectionNotes>Restricted to Graduate - Urbana-Champaign.</sectionNotes><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2013-08-26Z</startDate><endDate>2013-12-11Z</endDate><meetings><meeting id="0"><type code="L2 ">Lecture</type><start>11:00 AM</start><end>12:15 PM</end><daysOfTheWeek>TR     </daysOfTheWeek><roomNumber>1214</roomNumber><buildingName>Siebel Center for Comp Sci</buildingName><instructors><instructor lastName="Hoiem" firstName="D">Hoiem, D</instructor></instructors></meeting></meetings></ns2:section>