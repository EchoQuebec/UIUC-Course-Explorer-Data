<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="48337" href="schedule/2013/fall/ARTH/299/48337.xml"><parents><calendarYear id="2013" href="schedule/2013.xml">2013</calendarYear><term id="120138" href="schedule/2013/fall.xml">Fall 2013</term><subject id="ARTH" href="schedule/2013/fall/ARTH.xml">Art--History</subject><course id="299" href="schedule/2013/fall/ARTH/299.xml">Spec Topics in Art History</course></parents><sectionNumber>AH1</sectionNumber><sectionTitle>Sacred Arts of Africa</sectionTitle><statusCode>A</statusCode><sectionText>Topic: Sacred Arts of Africa. This course explores how vision and imagery works to imbue daily experience with spiritual significance in a range of African cultures. We focus on popular visual culture, such as masquerading and the mural arts of cities, to consider the ways objects, images, or places activate devotional experience.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2013-08-26Z</startDate><endDate>2013-12-11Z</endDate><meetings><meeting id="0"><type code="LEC">Lecture</type><start>09:00 AM</start><end>10:20 AM</end><daysOfTheWeek>MW     </daysOfTheWeek><roomNumber>240</roomNumber><buildingName>Art and Design Building</buildingName><instructors><instructor lastName="Meier" firstName="S">Meier, S</instructor></instructors></meeting></meetings></ns2:section>