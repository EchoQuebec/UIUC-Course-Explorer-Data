<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="HDFS 120" href="schedule/2014/spring/HDFS/120.xml"><parents><calendarYear id="2014" href="schedule/2014.xml">2014</calendarYear><term id="120141" href="schedule/2014/spring.xml">Spring 2014</term><subject id="HDFS" href="schedule/2014/spring/HDFS.xml">Human Development and Family Studies</subject></parents><label>Intro to Family Studies</label><description>Overview of current concepts, theories, and substantive issues in family studies from an interdisciplinary perspective. Gives attention to variation in family form and function across different social/cultural contexts and how family experience is structured by gender. Examines issues of family development (marriage, parenting, divorce, remarriage, aging family) and explores the links between families and other social institutions.</description><creditHours>3 hours.</creditHours><sectionDegreeAttributes>UIUC Social Sciences course.</sectionDegreeAttributes><genEdCategories><category id="SBS"><description>Social &amp; Behavioral Sciences</description><ns2:genEdAttributes><genEdAttribute code="1SS">Social &amp; Beh Sci - Soc Sci</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="33680" href="schedule/2014/spring/HDFS/120/33680.xml">AD1</section><section id="33683" href="schedule/2014/spring/HDFS/120/33683.xml">AD2</section><section id="33732" href="schedule/2014/spring/HDFS/120/33732.xml">AD3</section><section id="33785" href="schedule/2014/spring/HDFS/120/33785.xml">AE1</section><section id="58550" href="schedule/2014/spring/HDFS/120/58550.xml">C  </section></sections></ns2:course>