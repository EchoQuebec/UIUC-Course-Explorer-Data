<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:section xmlns:ns2="http://rest.cis.illinois.edu" id="58939" href="schedule/2014/spring/PHIL/530/58939.xml"><parents><calendarYear id="2014" href="schedule/2014.xml">2014</calendarYear><term id="120141" href="schedule/2014/spring.xml">Spring 2014</term><subject id="PHIL" href="schedule/2014/spring/PHIL.xml">Philosophy</subject><course id="530" href="schedule/2014/spring/PHIL/530.xml">Dissertation Seminar</course></parents><sectionNumber>DK </sectionNumber><sectionTitle>Writing Seminar</sectionTitle><creditHours>3 hours</creditHours><statusCode>A</statusCode><sectionText>WRITING SEMINAR.  The central objective of the course is to learn the necessary skills for developing drafts of papers, dissertation chapters, and/or dissertation proposals for preliminary examinations into publishable articles. Class meetings will be structured around conference-style presentations and intensive workshopping of the presented papers. The course provides an especially useful forum for developing dissertation proposals prior to their defense.</sectionText><partOfTerm>1</partOfTerm><sectionStatusCode>A</sectionStatusCode><enrollmentStatus>UNKNOWN</enrollmentStatus><startDate>2014-01-21Z</startDate><endDate>2014-05-07Z</endDate><meetings><meeting id="0"><type code="LEC">Lecture</type><start>04:00 PM</start><end>05:50 PM</end><daysOfTheWeek>M      </daysOfTheWeek><roomNumber>402</roomNumber><buildingName>Gregory Hall</buildingName><instructors><instructor lastName="Sussman" firstName="D">Sussman, D</instructor></instructors></meeting></meetings></ns2:section>