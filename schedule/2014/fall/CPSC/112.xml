<?xml version="1.0" encoding="UTF-8" standalone="yes"?><ns2:course xmlns:ns2="http://rest.cis.illinois.edu" id="CPSC 112" href="schedule/2014/fall/CPSC/112.xml"><parents><calendarYear id="2014" href="schedule/2014.xml">2014</calendarYear><term id="120148" href="schedule/2014/fall.xml">Fall 2014</term><subject id="CPSC" href="schedule/2014/fall/CPSC.xml">Crop Sciences</subject></parents><label>Introduction to Crop Sciences</label><description>Introductory course covering principles of growth, production, protection, and improvement of crop plants. Topics covered include form, function, and uses of crops; mechanisms and factors responsible for plant growth and development; crop pests and pest protection; specific crops; and advances in crop production. Concepts are discussed in lecture and reinforced in corresponding hands-on laboratory sections.</description><creditHours>4 hours.</creditHours><genEdCategories><category id="NAT"><description>Natural Sciences &amp; Technology</description><ns2:genEdAttributes><genEdAttribute code="1LS">Nat Sci &amp; Tech - Life Sciences</genEdAttribute></ns2:genEdAttributes></category></genEdCategories><sections><section id="31643" href="schedule/2014/fall/CPSC/112/31643.xml">AB1</section><section id="31644" href="schedule/2014/fall/CPSC/112/31644.xml">AB2</section><section id="58247" href="schedule/2014/fall/CPSC/112/58247.xml">AB3</section><section id="63201" href="schedule/2014/fall/CPSC/112/63201.xml">AB4</section><section id="63222" href="schedule/2014/fall/CPSC/112/63222.xml">AB5</section><section id="31645" href="schedule/2014/fall/CPSC/112/31645.xml">AL1</section><section id="63271" href="schedule/2014/fall/CPSC/112/63271.xml">AL2</section></sections></ns2:course>